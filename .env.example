STRIPE_SECRET_KEY=sk_test_...

# One Product, two Prices — one per language edition (signed no longer
# costs extra, so there's no separate "signed" price anymore).
#   "Book Title — English edition"  -> STRIPE_PRICE_EN
#   "Book Title — Spanish edition"  -> STRIPE_PRICE_ES
STRIPE_PRICE_EN=price_...
STRIPE_PRICE_ES=price_...

# From `stripe listen` (see README) while developing locally.
# In production (Netlify), this comes from the webhook endpoint you create
# in the Stripe Dashboard instead.
STRIPE_WEBHOOK_SECRET=whsec_...

# Used to build absolute success/cancel URLs for Stripe Checkout.
# netlify dev sets this automatically; set it to your real Netlify URL in production.
URL=http://localhost:8888

# Where to tell customers to send Venmo/Zelle payments (manual payment path).
# Shown to customers verbatim in payment instructions — use the real handle.
VENMO_HANDLE=@replace-with-real-venmo-handle
ZELLE_CONTACT=replace-with-real-zelle-email-or-phone
